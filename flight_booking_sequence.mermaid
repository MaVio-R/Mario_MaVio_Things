sequenceDiagram
    participant U as Utente
    participant BP as BookPage
    participant C as Controller
    participant B as Booking
    participant DB as Database

    U->>BP: Press Book Button
    BP->>BP: Validate Input Fields
    
    alt Input validation fails
        BP->>U: Show Error Message
    else Input validation success
        BP->>C: bookFlight(flightNumber, firstName, lastName)
        C->>C: Validate Parameters
        
        alt Parameter validation fails
            C->>BP: return false
            BP->>U: Show Validation Error
        else Parameter validation success
            C->>B: createBooking(flightNumber, firstName, lastName)
            B->>B: getFlightIdByNumber(flightNumber)
            
            alt Flight not found
                B->>BP: return false
                BP->>U: Show "Flight Not Found" Error
            else Flight found
                B->>DB: INSERT INTO booking
                
                alt Database operation fails
                    DB->>B: SQLException
                    B->>BP: return false
                    BP->>U: Show Database Error
                else Database operation success
                    DB->>B: rowsAffected > 0
                    B->>BP: return true
                    BP->>U: Show Success Message
                    BP->>BP: resetPanel()
                end
            end
        end
    end